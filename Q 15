#include <iostream>
using namespace std;

int main() {
    int a[5], key, l=0, h=4, mid;
    for(int i=0;i<5;i++) cin >> a[i];
    cin >> key;

    while(l<=h) {
        mid=(l+h)/2;
        if(a[mid]==key) {
            cout << "Found";
            return 0;
        }
        if(a[mid]<key) l=mid+1;
        else h=mid-1;
    }

    cout << "Not Found";
    return 0;
}
