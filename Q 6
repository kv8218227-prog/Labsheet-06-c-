#include <iostream>
using namespace std;

int main() {
    int a[5], key, found=0;
    for(int i=0; i<5; i++) cin >> a[i];
    cin >> key;

    for(int i=0; i<5; i++) {
        if(a[i]==key) {
            found=1;
            break;
        }
    }

    if(found) cout << "Element Found";
    else cout << "Element Not Found";
    return 0;
}
